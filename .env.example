# VikingPilot — miljøvariabler
#
# Kopier denne filen til .env og fyll inn verdier.
# .env er ignorert av git og skal ALDRI committes.
#
# Ingen hemmeligheter skal ligge i repo, logger eller feilmeldinger.
# Denne filen inneholder derfor bare navn og plassholdere — aldri ekte verdier.

# ---------------------------------------------------------------------------
# Påkrevd
# ---------------------------------------------------------------------------

# Postgres. Lokalt, eller DATABASE_URL fra Railway sin Postgres-tjeneste.
DATABASE_URL="postgresql://postgres:BYTT_UT_PASSORD@localhost:5432/vikingpilot?schema=public"

# Signerer sesjonscookien. Generer med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generer-en-tilfeldig-verdi"

# ---------------------------------------------------------------------------
# Cron — hver jobb har sin egen hemmelighet, slik at én manglende nøkkel
# bare tar ned én jobb.
# ---------------------------------------------------------------------------

CRON_SECRET_ENHETSREGISTER=""
CRON_SECRET_SEKVENS=""
CRON_SECRET_UTSENDING=""
CRON_SECRET_OPPVARMING=""
CRON_SECRET_RYDDING=""

# ---------------------------------------------------------------------------
# Enhetsregisteret — valgfritt. Uten nøkkel sier systemet «ikke konfigurert»
# og finner ikke på data.
# ---------------------------------------------------------------------------

ENHETSREGISTERET_API_KEY=""
ENHETSREGISTERET_BASE_URL=""

# ---------------------------------------------------------------------------
# E-post — valgfritt. Uten disse sier utsendingsvakten «ikke konfigurert»,
# og ingenting sendes.
# ---------------------------------------------------------------------------

EPOST_KANAL=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_BRUKER=""
SMTP_PASSORD=""
EPOST_FRA_ADRESSE=""
EPOST_FRA_NAVN="Vikingnet"
EPOST_SVAR_TIL=""

# All utgående trafikk er AV som standard. Se docs/beslutninger.md B-004.
UTGAAENDE_EPOST_AKTIVERT="false"

# ---------------------------------------------------------------------------
# VikingCRM — valgfritt. Vi snakker med den via webhook. Vi endrer den ikke.
# ---------------------------------------------------------------------------

VIKINGCRM_WEBHOOK_URL=""
VIKINGCRM_WEBHOOK_SECRET=""
VIKINGCRM_INNKOMMENDE_SECRET=""

# ---------------------------------------------------------------------------
# Agentplattformen — valgfritt. Omtales aldri ved produktnavn i kode.
# Variablene er nøytrale med vilje. Se docs/beslutninger.md B-002.
# ---------------------------------------------------------------------------

AGENT_WEBHOOK_URL=""
AGENT_WEBHOOK_SECRET=""
AGENT_INNKOMMENDE_SECRET=""
MCP_ENDPOINT_STI=""

# ---------------------------------------------------------------------------
# Drift
# ---------------------------------------------------------------------------

TIDSONE="Europe/Oslo"
LOGG_NIVAA="info"
RATE_LIMIT_PER_MINUTT="60"

# Alle sendende ruter tørrkjører med mindre annet eksplisitt sies.
STANDARD_TORRKJORING="true"
